{
  "name": "v-streamer-tools",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy --keep-vars",
    "upload:cloudflare": "npm run build:cloudflare && wrangler versions upload --keep-vars",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "postbuild": "node scripts/static-export-rsc-aliases.mjs",
    "lint": "eslint .",
    "audit:prod": "npm audit --omit=dev",
    "start": "next start"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "next": "16.2.6",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "server-only": "^0.0.1",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@types/node": "20.17.57",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.4",
    "postcss": "8.5.10",
    "supabase": "^2.109.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "wrangler": "^4.95.0"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
