{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "v-streamer-tools",
  "main": "workers/comment-translator-paid-open-next-wrapper.mjs",
  "compatibility_date": "2026-05-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
